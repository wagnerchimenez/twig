            <div class="row g-3 mt-3">
                <div class="col-md-4"><div class="p-3 bg-light rounded"><strong>Extends</strong><br><small>Layouts compartilhados</small></div></div>
                <div class="col-md-4"><div class="p-3 bg-light rounded"><strong>Include</strong><br><small>Componentes isolados</small></div></div>
                <div class="col-md-4"><div class="p-3 bg-light rounded"><strong>Macros</strong><br><small>HTML reutilizável</small></div></div>
            </div>
        </div>
    </div>
</main>

{% endblock %}

