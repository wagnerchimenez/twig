{% macro input(nome) %}

    <label class="form-label" for="{{ nome }}">{{ nome|capitalize }}:</label>
    <input class="form-control mb-3" type="text" id="{{ nome }}" name="{{ nome }}">

{% endmacro %}

{% macro submit(valor) %}
    <button class="btn btn-primary" type="submit">{{ valor|capitalize }}</button>
{% endmacro %}
